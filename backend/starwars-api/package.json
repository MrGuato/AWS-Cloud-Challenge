{
  "name": "starwars-api",
  "version": "2.0.0",
  "private": true,
  "description": "Cyber x Star Wars intel API for cloud.mrcyberleon.org (AWS Lambda + API Gateway, deployed with the Serverless Framework)",
  "main": "handler.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "deploy": "serverless deploy --stage dev",
    "info": "serverless info --stage dev",
    "logs": "serverless logs --function starwarsfact --stage dev --tail",
    "repair-stack": "bash scripts/repair-stack.sh"
  },
  "keywords": [
    "aws",
    "lambda",
    "api-gateway",
    "serverless",
    "star-wars",
    "cybersecurity"
  ],
  "author": "Jonathan DeLeon",
  "license": "ISC",
  "devDependencies": {
    "serverless": "^4.9.0"
  }
}
